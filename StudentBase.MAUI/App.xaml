<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StudentBase.MAUI.Converters"
             x:Class="StudentBase.MAUI.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:TermsToStringConverter x:Key="TermsToStringConverter" />
            <local:StatusProgramsToStringConverter x:Key="StatusProgramsToStringConverter" />
            <local:FormsOfEducationToStringConveter x:Key="FormsOfEducationToStringConveter" />
            <local:LevelsOfEducationToStringConverter x:Key="LevelsOfEducationToStringConverter" />
            <local:StatusGroupsToStringConverter x:Key="StatusGroupsToStringConverter" />
            <local:StatusStudentsToStringConverter x:Key="StatusStudentsToStringConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
