<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentBase.MAUI.MainPage"
             Title="Главная">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Архив" Command="{Binding ArchiveCommand}" />
    </ContentPage.ToolbarItems>

    <!-- Корневой Grid для адаптивного макета -->
    <Grid RowSpacing="12" ColumnSpacing="12">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: сводка -->
        <Grid >
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Карточка: Студенты -->
            <Frame Grid.Column="0" CornerRadius="8" Padding="12" HasShadow="True" >
                <StackLayout>
                    <Label Text="Студенты" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding NumberOfStudents}" FontSize="22" FontAttributes="Bold" />
                    <Label Text="активных" FontSize="12" />
                </StackLayout>
            </Frame>

            <!-- Карточка: Группы -->
            <Frame Grid.Column="1" CornerRadius="8" Padding="12" HasShadow="True" >
                <StackLayout>
                    <Label Text="Группы" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding NumberOfGroups}" FontSize="22" FontAttributes="Bold" />
                    <Label Text="активных" FontSize="12" />
                </StackLayout>
            </Frame>

            <!-- Карточка: Программы -->
            <Frame Grid.Column="2" CornerRadius="8" Padding="12" HasShadow="True" >
                <StackLayout>
                    <Label Text="Программы" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding NumberOfPrograms}" FontSize="22" FontAttributes="Bold" />
                    <Label Text="доступных" FontSize="12" />
                </StackLayout>
            </Frame>

            <!-- Карточка: Просрочки -->
            <Frame Grid.Column="3" CornerRadius="8" Padding="12" HasShadow="True" >
                <StackLayout>
                    <Label Text="Просрочки" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding NumberOfOverduePayments}" FontSize="22" FontAttributes="Bold" />
                    <Label Text="требует внимания" FontSize="12" />
                </StackLayout>
            </Frame>

        </Grid>

        <HorizontalStackLayout Grid.Row="1" Spacing="50" Padding="10">
            <Label Text="Быстрые действия: " FontAttributes="Bold" FontSize="20" />
            <Button Text="Перевести студента" Command="{Binding TransferStudentCommand}"  HeightRequest="40"/>
            <Button Text="Создать новую квитанцию" Command="{Binding CreateReceiptCommand}"  HeightRequest="40"/>
        </HorizontalStackLayout>

        <Border Grid.Row="2"  >
            <Grid Grid.Row="2" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Text="Список должников по оплате" HorizontalOptions="Center" Padding="3" FontSize="16" FontAttributes="Bold" TextColor="#444"/>
                <ScrollView Grid.Column="0" Grid.Row="1">
                    <CollectionView ItemsSource="{Binding Вebtors}"
                                    SelectedItem="{Binding SelectedDebtors}"
                                    SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <!-- дописать -->
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ScrollView>
                <Label Text="Переводы" Grid.Column="1" HorizontalOptions="Center" Padding="3" FontSize="16" FontAttributes="Bold" TextColor="#444"/>
                    <ScrollView Grid.Column="1" Grid.Row="1" >
                    <CollectionView ItemsSource="{Binding Translations}" 
                                    SelectedItem="{Binding SelectedTranslations}"
                                    SelectionMode="Single">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <!-- дописать -->
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>


            </Grid>
        </Border>
    </Grid>
</ContentPage>
