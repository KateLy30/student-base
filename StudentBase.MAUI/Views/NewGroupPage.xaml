<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StudentBase.MAUI.NewGroupPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry" >
            <Setter Property="TextColor" Value="Red"/>
            <Setter Property="BackgroundColor" Value="#FFF0F0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>

        <VerticalStackLayout Padding="10" Spacing="3">
            
            <Label Text="Название группы" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Введите название группы" >
                <Entry.Behaviors >
                    <toolkit:TextValidationBehavior MinimumLength="1" x:Name="NameValidator"
                                                    Flags="ValidateOnValueChanged,ValidateOnUnfocusing"
                                                    InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                </Entry.Behaviors>
            </Entry>
            <Label Text="Поле обязательно" FontSize="12" TextColor="Red" IsVisible="{Binding IsNotValid, Source={x:Reference NameValidator}}" />

            <Label Text="Дата создания группы" />
            <DatePicker Date="{Binding DateOfCreation}"  Format="d" FontSize="16" MinimumDate="01/01/2010"/>

            <Picker ItemsSource="{Binding Programs}"
                    ItemDisplayBinding="{Binding DisplayText}"
                    SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                    Title="Программа обучения"  />

            <Picker ItemsSource="{Binding StatusList}"
                    SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                    Title="Статус">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource StatusGroupsToStringConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <HorizontalStackLayout Padding="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="Ок" Margin="10" Command="{Binding SaveCommand}"/>
                <Button Text="Отмена" Margin="10" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>