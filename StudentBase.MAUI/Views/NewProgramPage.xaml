<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StudentBase.MAUI.Views.NewProgramPage"
             Title="{Binding Title}">
    <!--Свойство Title меняется в зависимости от режима окна 
                                        (редактирование или новая запись) в NewProgramViewModel -->
    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry" >
            <Setter Property="TextColor" Value="#DC3545"/>
            <Setter Property="BackgroundColor" Value="#FFF0F0" />
        </Style>
        
        <!-- Стиль для основных Entry -->
        <Style x:Key="ModernEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="PlaceholderColor" Value="#9E9E9E"/>
        </Style>

        <!-- Стиль для Picker -->
        <Style x:Key="ModernPickerStyle" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TitleColor" Value="#9E9E9E"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" RowSpacing="0">

        <!-- Заголовок -->
        <Border StrokeThickness="0" 
         Padding="15,10" 
         BackgroundColor="Gray">
            <Label Text="{Binding Title}" 
                FontSize="20" 
                FontAttributes="Bold" 
                TextColor="White"
                VerticalOptions="Center"/>
        </Border>


        <ScrollView Grid.Row="1" BackgroundColor="#F5F5F5">
            
            <VerticalStackLayout Spacing="15" Padding="15">
                
                <Border StrokeThickness="1" 
                        Padding="15"
                        BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="12">
                        
                        <!-- Специальность -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Специальность" 
                                   FontSize="14" 
                                   TextColor="#757575"/>
                            <Entry Text="{Binding Specialty, Mode=TwoWay}" 
                                   Placeholder="Введите специальность"
                                   Style="{StaticResource ModernEntryStyle}">
                                <Entry.Behaviors>
                                    <toolkit:TextValidationBehavior MinimumLength="1" 
                                                                  x:Name="SpecialtyValidator"
                                                                  Flags="ValidateOnValueChanged,ValidateOnUnfocusing"
                                                                  InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                                </Entry.Behaviors>
                            </Entry>
                            <Label Text="Поле обязательно" 
                                   FontSize="12" 
                                   TextColor="#DC3545" 
                                   IsVisible="{Binding IsNotValid, Source={x:Reference SpecialtyValidator}}" />
                        </VerticalStackLayout>
                        
                        <!-- Квалификация -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Квалификация" 
                                   FontSize="14" 
                                   TextColor="#757575"/>
                            <Entry Text="{Binding Qualification, Mode=TwoWay}" 
                                   Placeholder="Введите квалификацию"
                                   Style="{StaticResource ModernEntryStyle}">
                                <Entry.Behaviors>
                                    <toolkit:TextValidationBehavior MinimumLength="1" 
                                                                  x:Name="QualificationValidator"
                                                                  Flags="ValidateOnValueChanged, ValidateOnUnfocusing"
                                                                  InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                                </Entry.Behaviors>
                            </Entry>
                            <Label Text="Поле обязательно" 
                                   FontSize="12" 
                                   TextColor="#DC3545" 
                                   IsVisible="{Binding IsNotValid, Source={x:Reference QualificationValidator}}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">

                            <!-- Продолжительность обучения -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Продолжительность" 
                                       FontSize="14" 
                                       TextColor="#757575"/>
                                <Border StrokeThickness="1" Padding="5"
                                        BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Picker ItemsSource="{Binding TermsOfStudyList}"
                                            SelectedItem="{Binding SelectedTermOfStudy, Mode=TwoWay}" 
                                            Title="Выберите срок"
                                            Style="{StaticResource ModernPickerStyle}">
                                        <Picker.ItemDisplayBinding>
                                            <Binding Path="." Converter="{StaticResource TermsToStringConverter}" />
                                        </Picker.ItemDisplayBinding>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Статус -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Статус программы" 
                                       FontSize="14" 
                                       TextColor="#757575"/>
                                <Border StrokeThickness="1" Padding="5"
                                        BackgroundColor="White">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Picker ItemsSource="{Binding StatusList}"
                                            SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" 
                                            Title="Выберите статус"
                                            Style="{StaticResource ModernPickerStyle}">
                                        <Picker.ItemDisplayBinding>
                                            <Binding Path="." Converter="{StaticResource StatusProgramsToStringConverter}" />
                                        </Picker.ItemDisplayBinding>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        
                        <!-- Стоимость обучения -->
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Стоимость обучения" 
                                   FontSize="14" 
                                   TextColor="#757575"/>
                            <Entry Text="{Binding Cost, Mode=TwoWay}" 
                                   Keyboard="Numeric" 
                                   Placeholder="Введите стоимость"
                                   Style="{StaticResource ModernEntryStyle}">
                                <Entry.Behaviors>
                                    <toolkit:NumericValidationBehavior x:Name="CostValidator" 
                                                                      MinimumValue="1"
                                                                      Flags="ValidateOnValueChanged"
                                                                      InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                                </Entry.Behaviors>
                            </Entry>
                            <Label Text="Поле обязательно" 
                                   FontSize="12" 
                                   TextColor="#DC3545" 
                                   IsVisible="{Binding IsNotValid, Source={x:Reference CostValidator}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Кнопки действий -->
                <HorizontalStackLayout Spacing="10" 
                        HorizontalOptions="Center" 
                        Margin="20">

                    <Button Text="Сохранить" 
                            Command="{Binding SaveCommand}"
                            FontSize="16"
                            Padding="25,15"
                            CornerRadius="25"
                            WidthRequest="150"/>

                    <Button Text="Отмена" 
                            Command="{Binding CancelCommand}"
                            FontSize="16"
                            Padding="25,15"
                            CornerRadius="25"
                            WidthRequest="150"/>
                </HorizontalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>