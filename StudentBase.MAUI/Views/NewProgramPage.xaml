<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StudentBase.MAUI.Views.NewProgramPage"
             Title="{Binding Title}">
    <!--Свойство Title меняется в зависимости от режима окна 
                                        (редактирование или новая запись) в NewProgramViewModel -->
    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry" >
            <Setter Property="TextColor" Value="Red"/>
            <Setter Property="BackgroundColor" Value="#FFF0F0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="3">

            <Label Text="Специальность" />
            <Entry Text="{Binding Specialty, Mode=TwoWay}" Placeholder="Введите специальность" >
                <Entry.Behaviors>
                    <toolkit:TextValidationBehavior MinimumLength="1" x:Name="SpecialtyValidator"
                                     Flags="ValidateOnValueChanged,ValidateOnUnfocusing"
                                     InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                </Entry.Behaviors>
            </Entry>
            <Label Text="Поле обязательно" FontSize="12" TextColor="Red" IsVisible="{Binding IsNotValid, Source={x:Reference SpecialtyValidator}}" />


            <Label Text="Квалификация" Margin="0,10,0,0" />
            <Entry Text="{Binding Qualification, Mode=TwoWay}" Placeholder="Введите квалификацию" >
                <Entry.Behaviors>
                    <toolkit:TextValidationBehavior MinimumLength="1" x:Name="QulificationValidator"
                                                    Flags="ValidateOnValueChanged, ValidateOnUnfocusing"
                                                    InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                </Entry.Behaviors>
            </Entry>
            <Label Text="Поле обязательно" FontSize="12" TextColor="Red" IsVisible="{Binding IsNotValid, Source={x:Reference QulificationValidator}}" />

            <HorizontalStackLayout Spacing="20">
                <Picker ItemsSource="{Binding TermsOfStudyList}" Margin="0,10,0,0"
                    SelectedItem="{Binding SelectedTermOfStudy, Mode=TwoWay}" 
                    Title="Продолжительность обучения" WidthRequest="300" HorizontalOptions="Start" >
                    <Picker.ItemDisplayBinding>
                        <Binding Path="." Converter="{StaticResource TermsToStringConverter}" />
                    </Picker.ItemDisplayBinding>
                </Picker>

                <Picker ItemsSource="{Binding StatusList}" Margin="0,10,0,0"
                        SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" 
                         Title="Статус" WidthRequest="300" HorizontalOptions="Start">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="." Converter="{StaticResource StatusProgramsToStringConverter}" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </HorizontalStackLayout>


            <Label Text="Стоимость" Margin="0,10,0,0"/>
            <Entry Text="{Binding Cost, Mode=TwoWay}" Keyboard="Numeric" >
                <Entry.Behaviors>
                    <toolkit:NumericValidationBehavior x:Name="CostValidator" MinimumValue="1"
                                                           Flags="ValidateOnValueChanged"
                                                           InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                </Entry.Behaviors>
            </Entry>
            <Label Text="Поле обязательно" FontSize="12" TextColor="Red" IsVisible="{Binding IsNotValid, Source={x:Reference CostValidator}}" />

            <HorizontalStackLayout Padding="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="Ок" Margin="10" Command="{Binding SaveCommand}" />
                <Button Text="Отмена" Margin="10" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>