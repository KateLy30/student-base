<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StudentBase.MAUI.NewStudentPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry" >
            <Setter Property="TextColor" Value="Red"/>
            <Setter Property="BackgroundColor" Value="#FFF0F0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="3">

            <Label Text="ФИО" />
            <Entry Text="{Binding Name, Mode=TwoWay}" Placeholder="Введите ФИО студента" >
                <Entry.Behaviors>
                    <toolkit:TextValidationBehavior x:Name="NameValidator" MinimumLength="1"
                                                    Flags="ValidateOnValueChanged,ValidateOnUnfocusing"
                                                    InvalidStyle="{StaticResource InvalidEntryStyle}"/>
                </Entry.Behaviors>
            </Entry>
            <Label Text="Поле обязательно" FontSize="12" TextColor="Red" IsVisible="{Binding IsNotValid, Source={x:Reference NameValidator}}" />

            <Label Text="Номер телефона" Margin="0,10,0,0" />
            <Entry Text="{Binding Phone, Mode=TwoWay}" Keyboard="Telephone" Placeholder="+7 (___) ___-__-__">
                <Entry.Behaviors>
                    <toolkit:MaskedBehavior Mask="+7 (XXX) XXX-XX-XX" UnmaskedCharacter="X" />
                    <toolkit:TextValidationBehavior x:Name="PhoneValidator" MinimumLength="18"
                                                    Flags="ValidateOnValueChanged,ValidateOnUnfocusing"
                                                    InvalidStyle="{StaticResource InvalidEntryStyle}" />
                </Entry.Behaviors>
            </Entry>
            
            <HorizontalStackLayout Spacing="40">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Дата рождения" Margin="0,10,0,0"/>
                    <DatePicker Format="d" Date="{Binding DateOfBirth}" FontSize="16" MinimumDate="01/01/1950" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Дата поступления" Margin="0,10,0,0"/>
                    <DatePicker Format="d" Date="{Binding DateOfReceipt}" FontSize="16" MinimumDate="01/01/2010"  />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="20">

                <Picker ItemsSource="{Binding EducationLevelsList}" Margin="0,10,0,0"
                        SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" 
                        Title="Уровень образования" WidthRequest="400" HorizontalOptions="Start">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="." Converter="{StaticResource LevelsOfEducationToStringConverter}" />
                    </Picker.ItemDisplayBinding>
                </Picker>

                <Picker ItemsSource="{Binding FormsOfEducationList}" Margin="0,10,0,0"
                        SelectedItem="{Binding SelectedForm, Mode=TwoWay}"
                        Title="Форма обучения" WidthRequest="300" HorizontalOptions="Start" >
                    <Picker.ItemDisplayBinding>
                        <Binding Path="." Converter="{StaticResource FormsOfEducationToStringConveter}" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </HorizontalStackLayout>
            <Picker ItemsSource="{Binding Groups}" Margin="0,10,0,0"
                    ItemDisplayBinding="{Binding Name}" 
                    SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                    Title="Группа" WidthRequest="500" HorizontalOptions="Start"/>

            <Picker ItemsSource="{Binding StatusList}" Margin="0,10,0,0"
                    SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" 
                    Title="Статус" WidthRequest="500" HorizontalOptions="Start">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource StatusStudentsToStringConverter}"/>
                </Picker.ItemDisplayBinding>
            </Picker>


            <HorizontalStackLayout Padding="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="Ок" Margin="10" Command="{Binding SaveCommand}"/>
                <Button Text="Отмена" Margin="10" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>