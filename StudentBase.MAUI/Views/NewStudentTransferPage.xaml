<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentBase.MAUI.Views.NewStudentTransferPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="3">

            <Picker Title="Студент" ItemsSource="{Binding Students}"
                    SelectedItem="{Binding SelectedStudent}"/>

            <Picker Title="Группа" ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup}" Margin="0,10,0,0"/>

            <Label Text="Дата перевода" Margin="0,10,0,0"/>
            <DatePicker Date="{Binding TransferDate}" Format="d" FontSize="16" MinimumDate="01/01/2010"/>

            <HorizontalStackLayout Padding="10" HorizontalOptions="Center" VerticalOptions="Center">
                <Button Text="Ок" Margin="10" Command="{Binding SaveCommand}"/>
                <Button Text="Отмена" Margin="10" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>