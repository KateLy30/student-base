<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentBase.MAUI.Views.PaymentPage"
             x:Name="ThisPage"
             Title="Оплата">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Создать новую квитанцию" Command="{Binding AddReceiptCommand}" />
    </ContentPage.ToolbarItems>

    <Grid Padding="5" RowDefinitions="Auto,*,Auto" RowSpacing="5" >

        <Grid ColumnDefinitions="*,Auto,Auto" Padding="5" ColumnSpacing="10"
              RowDefinitions="*,Auto" RowSpacing="5">

            <SearchBar Placeholder="Поиск.." SearchCommand="{Binding FindReceiptCommand}"
                       Text="{Binding SearchText, Mode=TwoWay}"/>

            <ImageButton Source="load_icon.png" Grid.Column="1"
                         Command="{Binding LoadCommand}" BorderWidth="0"
                         ToolTipProperties.Text="Загрузка всего списка из базы."/>

            <ActivityIndicator Grid.ColumnSpan="2" Grid.Row="1"
                               IsVisible="{Binding IsBusy}"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <CollectionView ItemsSource="{Binding Payments}">

                <CollectionView.EmptyView>
                    <StackLayout HorizontalOptions="Center"
                  VerticalOptions="Center">
                        <Label Text="История платежей пуста"
                 HorizontalOptions="Center"
                 FontSize="16" TextColor="#757575"/>
                    </StackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Padding="0,5,0,5">
                            <Border Style="{StaticResource BorderCollectionItem}" >
                                <Grid Padding="10,5,10,5" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18"/>
                                        <Label Text="{Binding PaymentDate, StringFormat='{0:dd.MM.yyyy}'}" TextColor="Gray" FontSize="16"/>
                                        <Label Text="{Binding Amount, StringFormat='{0:C}'}" FontSize="16" TextColor="Gray"/>
                                        <Label Text="{Binding PaidSemester, StringFormat='Семестр: {0}'}" FontSize="16" TextColor="Gray"/>
                                    </StackLayout>

                                    <ImageButton Source="delete_icon.png" 
                                                  Grid.Column="1" Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCommand}"
                                                  CommandParameter="{Binding}" HeightRequest="30"/>     
                                </Grid>
                            </Border>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2">
            <BoxView BackgroundColor="LightGray"  HeightRequest="0.5"/>
            <Label HeightRequest="30" HorizontalOptions="End" Text="{Binding NumberOfEntries}" Padding="10" Margin="0,0,10,0" />
        </VerticalStackLayout>

    </Grid>
    
</ContentPage>